generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleSlug {
  ADMIN
  MANAGER
  STAFF
}

enum ProductUnit {
  PIECE
  BOX
  PACK
  BOTTLE
  CUP
  KG
  G
}

enum RestockStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LOW_STOCK
  RESTOCK_APPROVED
  RESTOCK_REJECTED
  RESTOCK_PENDING
  EXPIRY_SOON
}

enum InventoryLogType {
  TAKE
  RESTOCK
  ADJUST
  CREATE
}

model Role {
  id        String         @id @default(cuid())
  slug      RoleSlug       @unique
  name      String
  users     User[]
  takeLimit RoleTakeLimit?
}

model RoleTakeLimit {
  id         String @id @default(cuid())
  roleId     String @unique
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  maxPerTake Int    @default(5)
  maxPerDay  Int    @default(20)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restockRequestsRequested RestockRequest[] @relation("RequestedBy")
  restockRequestsReviewed  RestockRequest[] @relation("ReviewedBy")
  notifications            Notification[]
  inventoryLogs            InventoryLog[]
}

model Product {
  id                   String      @id @default(cuid())
  name                 String
  sku                  String      @unique
  category             String
  description          String?     @db.Text
  imageUrl             String?     @db.Text
  unit                 ProductUnit @default(PIECE)
  unitLabel            String?
  expiryDate           DateTime?
  lastExpiryNotifiedAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  inventory       Inventory?
  restockRequests RestockRequest[]
  logs            InventoryLog[]
}

model Inventory {
  id                     String    @id @default(cuid())
  productId              String    @unique
  product                Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity               Int
  lowStockThreshold      Int
  lastLowStockNotifiedAt DateTime?
}

model InventoryLog {
  id        String           @id @default(cuid())
  type      InventoryLogType
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  delta     Int
  note      String?
  createdAt DateTime         @default(now())

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RestockRequest {
  id            String        @id @default(cuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  requestedById String
  requestedBy   User          @relation("RequestedBy", fields: [requestedById], references: [id])
  quantity      Int
  status        RestockStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @db.Text
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
}
